{
  "name": "Кирилл Чигирин, юрист",
  "version": "2026.11",
  "concept": "Бумага, тушь, один синий. Портрет в зале Совета Федерации закреплён справа, текст идёт как юридический документ.",
  "color": {
    "paper": "#ecebe8",
    "surface": "#e1e0db",
    "ink": "#17181a",
    "inkSoft": "#4a4d53",
    "blue": "#17365f",
    "blueDeep": "#102744",
    "blueSoft": "#d9e1ec"
  },
  "typography": {
    "display": {
      "family": "Cormorant Garamond",
      "weight": 600,
      "size": "clamp(48px, 6.4vw, 92px)",
      "lineHeight": 0.96,
      "tracking": "-0.02em"
    },
    "heading": {
      "family": "Cormorant Garamond",
      "weight": 600,
      "size": "clamp(28px, 1.7vw + 1.15rem, 36px)",
      "lineHeight": 1.08,
      "tracking": "-0.01em"
    },
    "lead": {
      "family": "Inter",
      "weight": 500,
      "size": "22px",
      "lineHeight": 1.42
    },
    "body": {
      "family": "Inter",
      "weight": 400,
      "size": "17px",
      "lineHeight": 1.6
    },
    "small": {
      "family": "Inter",
      "weight": 400,
      "size": "14px",
      "lineHeight": 1.55
    }
  },
  "space": {
    "outer": "28px",
    "sectionDesktop": "84–140px",
    "sectionPhone": "72px",
    "block": "40–64px"
  },
  "grid": {
    "firstScreen": "1.06fr / 0.94fr",
    "services": "repeat(2, minmax(0, 1fr))",
    "cases": "5fr / 7fr",
    "pricing": "7fr / 5fr",
    "faq": "4fr / 8fr"
  },
  "radius": "0",
  "shadows": "none",
  "gradients": "none",
  "motion": {
    "ease": "cubic-bezier(.22, .61, .36, 1)",
    "reveal": "opacity и translateY(20px), 700ms, шаг 70ms",
    "portraitFade": "1400ms",
    "reducedMotion": "все переходы отключаются, остаётся статичный портрет"
  },
  "fonts": [
    {
      "family": "Cormorant Garamond",
      "license": "SIL Open Font License 1.1",
      "files": ["assets/fonts/cormorant-garamond-var-cyrillic.woff2", "assets/fonts/cormorant-garamond-var-latin.woff2"]
    },
    {
      "family": "Inter",
      "license": "SIL Open Font License 1.1",
      "files": ["assets/fonts/inter-var-cyrillic.woff2", "assets/fonts/inter-var-latin.woff2"]
    }
  ],
  "components": [
    "brand",
    "primary button",
    "paper button on blue",
    "text link",
    "navigation item",
    "fact list",
    "process steps",
    "service block",
    "case block",
    "price panel",
    "FAQ paragraph",
    "contact panel",
    "footer",
    "to-top control"
  ]
}
