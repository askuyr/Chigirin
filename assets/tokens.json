{
  "name": "Кирилл Чигирин, юрист",
  "version": "2026.11",
  "concept": "Бумага, тушь, синий и янтарное действие. Портрет в зале Совета Федерации закреплён справа, текст идёт как юридический документ.",
  "settings": {
    "boldness": 5,
    "animation": 7,
    "density": 7
  },
  "paletteSource": "ui-ux-pro-max, Legal Services: authority navy + trust gold, развёрнуто под плотность 7",
  "color": {
    "paper": "#f8fafc",
    "surface": "#e9eef5",
    "ink": "#0f172a",
    "inkSoft": "#475569",
    "blue": "#1e3a8a",
    "blueDeep": "#172554",
    "accent": "#b45309",
    "accentDeep": "#8a3f07"
  },
  "typography": {
    "display": {
      "family": "Cormorant Garamond",
      "weight": 600,
      "size": "clamp(48px, 6.4vw, 92px)",
      "lineHeight": 0.96,
      "tracking": "-0.02em"
    },
    "heading": {
      "family": "Cormorant Garamond",
      "weight": 600,
      "size": "clamp(30px, 1.2rem + 1.9vw, 40px)",
      "lineHeight": 1.08,
      "tracking": "-0.01em"
    },
    "subhead": {
      "family": "Cormorant Garamond",
      "weight": 600,
      "size": "clamp(26px, 1.45rem + .55vw, 28px)",
      "lineHeight": 1.15
    },
    "lead": {
      "family": "Inter",
      "weight": 500,
      "size": "22px",
      "lineHeight": 1.42
    },
    "body": {
      "family": "Inter",
      "weight": 400,
      "size": "17px",
      "lineHeight": 1.6
    },
    "small": {
      "family": "Inter",
      "weight": 400,
      "size": "14px",
      "lineHeight": 1.55
    }
  },
  "space": {
    "outer": "28px",
    "sectionDesktop": "64–104px",
    "sectionPhone": "64px",
    "block": "32–56px"
  },
  "grid": {
    "firstScreen": "1.06fr / 0.94fr",
    "services": "repeat(2, minmax(0, 1fr))",
    "cases": "5fr / 7fr",
    "pricing": "7fr / 5fr",
    "faq": "4fr / 8fr"
  },
  "radius": "0",
  "shadows": "none",
  "gradients": "none",
  "motion": {
    "ease": "cubic-bezier(.22, .61, .36, 1)",
    "smoothScroll": "Lenis 1.3.27, duration 1.15, wheelMultiplier .95, touchMultiplier 1.4",
    "reveal": "opacity и translateY(26px), 750ms, шаг 80ms",
    "portraitFade": "1400ms, медленный дрейф кадра 16s",
    "bandParallax": "±42px по скроллу",
    "reducedMotion": "Lenis, дрейф и появление отключаются"
  },
  "fonts": [
    {
      "family": "Cormorant Garamond",
      "license": "SIL Open Font License 1.1",
      "files": ["assets/fonts/cormorant-garamond-var-cyrillic.woff2", "assets/fonts/cormorant-garamond-var-latin.woff2"]
    },
    {
      "family": "Inter",
      "license": "SIL Open Font License 1.1",
      "files": ["assets/fonts/inter-var-cyrillic.woff2", "assets/fonts/inter-var-latin.woff2"]
    }
  ],
  "components": [
    "brand",
    "primary button",
    "paper button on blue",
    "text link",
    "navigation item",
    "fact list",
    "process steps",
    "service block",
    "case block",
    "price panel",
    "FAQ paragraph",
    "contact panel",
    "footer",
    "to-top control"
  ]
}
